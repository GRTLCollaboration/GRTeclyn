\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces The runaway, cell \texttt  {pair\_pm}, in the $z=0$ plane. Top row: scalar-field activity $\mathcal  {A}=\DOTSB \sum@ \slimits@ _k(\varphi _k^2+\Pi _k^2)^{1/2}$ summed over both sectors. Bottom row: conformal factor $\chi -1$; the phantom star is a hill ($\chi >1$, blue), the canonical star a well ($\chi <1$, red). Open markers show the measured sector barycentres (circle: canonical; square: phantom); dashed verticals at $x=\pm 4$ mark the release positions, with an arrow per sector showing its displacement---both bodies move in $+x$, the phantom chasing hardest. The bracket below each panel gives the instantaneous separation: $8.00\rightarrow 6.81\rightarrow 4.32\rightarrow 1.79$. Panels are individually color-scaled; the canonical well deepens from $\chi _{\min }=0.98$ to $0.44$ over the run.}}{5}{figure.2}\protected@file@percent }
\newlabel{fig:frames}{{2}{5}{The runaway, cell \texttt {pair\_pm}, in the $z=0$ plane. Top row: scalar-field activity $\mathcal {A}=\sum _k(\varphi _k^2+\Pi _k^2)^{1/2}$ summed over both sectors. Bottom row: conformal factor $\chi -1$; the phantom star is a hill ($\chi >1$, blue), the canonical star a well ($\chi <1$, red). Open markers show the measured sector barycentres (circle: canonical; square: phantom); dashed verticals at $x=\pm 4$ mark the release positions, with an arrow per sector showing its displacement---both bodies move in $+x$, the phantom chasing hardest. The bracket below each panel gives the instantaneous separation: $8.00\rightarrow 6.81\rightarrow 4.32\rightarrow 1.79$. Panels are individually color-scaled; the canonical well deepens from $\chi _{\min }=0.98$ to $0.44$ over the run}{figure.2}{}}
\@writefile{lot}{\contentsline {table}{\numberline {III}{\ignorespaces Mass-scaling test: canonical-star drift ratio between the equal-$|M|$ cell and the reference cell, against the same ratio in the point-mass model and the bare mass ratio $0.06395/0.07696=0.831$.}}{5}{table.3}\protected@file@percent }
\newlabel{tab:massscaling}{{III}{5}{Mass-scaling test: canonical-star drift ratio between the equal-$|M|$ cell and the reference cell, against the same ratio in the point-mass model and the bare mass ratio $0.06395/0.07696=0.831$}{table.3}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {D}Separation scaling: inverse-square once the stars separate}{5}{section*.15}\protected@file@percent }
