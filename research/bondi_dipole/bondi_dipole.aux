\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces The runaway, run \texttt  {PM}, in the $z=0$ plane. Top: scalar-field activity $\mathcal  {A}=\DOTSB \sum@ \slimits@ _k(\varphi _k^2+\Pi _k^2)^{1/2}$, both sectors. Bottom: $\chi -1$; the phantom star is a hill ($\chi >1$, blue), the canonical star a well ($\chi <1$, red). Open markers: measured barycentres (circle canonical, square phantom); dashed verticals mark the release positions $x=\pm 4$, arrows the displacements; brackets give the separation, $8.00\rightarrow 1.79$. Panels are individually color-scaled; the canonical well deepens from $\chi _{\min }=0.98$ to $0.44$.}}{5}{figure.2}\protected@file@percent }
\newlabel{fig:frames}{{2}{5}{The runaway, run \texttt {PM}, in the $z=0$ plane. Top: scalar-field activity $\mathcal {A}=\sum _k(\varphi _k^2+\Pi _k^2)^{1/2}$, both sectors. Bottom: $\chi -1$; the phantom star is a hill ($\chi >1$, blue), the canonical star a well ($\chi <1$, red). Open markers: measured barycentres (circle canonical, square phantom); dashed verticals mark the release positions $x=\pm 4$, arrows the displacements; brackets give the separation, $8.00\rightarrow 1.79$. Panels are individually color-scaled; the canonical well deepens from $\chi _{\min }=0.98$ to $0.44$}{figure.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces (a)~Barycentre worldlines of run \texttt  {PM}: released at rest at $x=\pm 4$, both bodies move in $+x$, the phantom (dashed) chasing the canonical star (solid); the shaded band is the closing gap. (b)~Drifts $\Delta x$, solid $\Phi _+$ and dashed $\Phi _-$: black, reference run; gray, \texttt  {PM-eq} (Sec.~\ref {sec:scaling}); light gray, all four null controls. The dotted line marks the clean-window edge $t=30$ (Sec.~\ref {sec:caveats}). (c)~Separation against the matched point-mass integrations: the NR gap closes to near-contact where the model predicts slow growth.}}{5}{figure.3}\protected@file@percent }
\newlabel{fig:traj}{{3}{5}{(a)~Barycentre worldlines of run \texttt {PM}: released at rest at $x=\pm 4$, both bodies move in $+x$, the phantom (dashed) chasing the canonical star (solid); the shaded band is the closing gap. (b)~Drifts $\Delta x$, solid $\Phi _+$ and dashed $\Phi _-$: black, reference run; gray, \texttt {PM-eq} (Sec.~\ref {sec:scaling}); light gray, all four null controls. The dotted line marks the clean-window edge $t=30$ (Sec.~\ref {sec:caveats}). (c)~Separation against the matched point-mass integrations: the NR gap closes to near-contact where the model predicts slow growth}{figure.3}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {B}The mirror control closes the artifact objection}{5}{section*.13}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Barycentre velocities in run \texttt  {PM}: centred differences of the continuously sampled barycentre stream over $\pm 2$ time units (canonical solid, phantom dashed; light gray: the matched point-mass model). The dotted line marks the clean-window edge $t=30$; beyond it the halo bias (Sec.~\ref {sec:caveats}) depresses the canonical curve.}}{6}{figure.4}\protected@file@percent }
\newlabel{fig:velocity}{{4}{6}{Barycentre velocities in run \texttt {PM}: centred differences of the continuously sampled barycentre stream over $\pm 2$ time units (canonical solid, phantom dashed; light gray: the matched point-mass model). The dotted line marks the clean-window edge $t=30$; beyond it the halo bias (Sec.~\ref {sec:caveats}) depresses the canonical curve}{figure.4}{}}
