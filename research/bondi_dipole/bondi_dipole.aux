\@writefile{lot}{\contentsline {table}{\numberline {II}{\ignorespaces Does the push scale with its source? Between \texttt  {PM-eq} and \texttt  {PM} one physical input changes: the phantom's mass magnitude, smaller by the factor $0.831$. ``NR ratio'': the canonical-star drift of \texttt  {PM-eq} over that of \texttt  {PM}, both at $\Delta x=0.25$; beside it the same ratio from the matched point-mass integrations, and the bare mass ratio. The last column is the phantom's own drift ratio, which the sign structure requires to be $1$.}}{7}{table.2}\protected@file@percent }
\newlabel{tab:massscaling}{{II}{7}{Does the push scale with its source? Between \texttt {PM-eq} and \texttt {PM} one physical input changes: the phantom's mass magnitude, smaller by the factor $0.831$. ``NR ratio'': the canonical-star drift of \texttt {PM-eq} over that of \texttt {PM}, both at $\Delta x=0.25$; beside it the same ratio from the matched point-mass integrations, and the bare mass ratio. The last column is the phantom's own drift ratio, which the sign structure requires to be $1$}{table.2}{}}
