\@writefile{lot}{\contentsline {table}{\numberline {III}{\ignorespaces Does the push scale with its source? Between runs \texttt  {PM-eq} and \texttt  {PM} exactly one physical input changes: the phantom's mass magnitude, smaller by the factor $0.06395/0.07696=0.831$. If the canonical star's motion is gravity sourced by the phantom, its drift must shrink by that same factor. ``NR ratio'': the measured canonical-star drift of \texttt  {PM-eq} divided by that of \texttt  {PM}; next to it, the same ratio predicted by the matched point-mass integrations, and the bare mass ratio itself.}}{8}{table.3}\protected@file@percent }
\newlabel{tab:massscaling}{{III}{8}{Does the push scale with its source? Between runs \texttt {PM-eq} and \texttt {PM} exactly one physical input changes: the phantom's mass magnitude, smaller by the factor $0.06395/0.07696=0.831$. If the canonical star's motion is gravity sourced by the phantom, its drift must shrink by that same factor. ``NR ratio'': the measured canonical-star drift of \texttt {PM-eq} divided by that of \texttt {PM}; next to it, the same ratio predicted by the matched point-mass integrations, and the bare mass ratio itself}{table.3}{}}
\@writefile{lot}{\contentsline {table}{\numberline {IV}{\ignorespaces Ratio of the measured phantom drift to each run's \emph  {own} matched point-mass integration. At $d_0=8$ the stars overlap from $t=0$.}}{8}{table.4}\protected@file@percent }
