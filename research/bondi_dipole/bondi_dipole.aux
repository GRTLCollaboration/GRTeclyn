\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Barycentre velocities in the reference cell, in code units ($c=1$): centred differences of the continuously sampled barycentre stream over $\pm 2$ time units ($\Phi _+$ solid, $\Phi _-$ dashed), against the matched point-mass model (gray). The phantom passes $v_x=0.027$ at $t=30$ and reaches $\approx 0.15$ by $t=60$; the canonical curve turns over near $t\approx 52$ as the halo bias of Sec.~\ref {sec:caveats} takes hold, which is a diagnostic effect and not a deceleration.}}{8}{figure.5}\protected@file@percent }
\newlabel{fig:velocity}{{5}{8}{Barycentre velocities in the reference cell, in code units ($c=1$): centred differences of the continuously sampled barycentre stream over $\pm 2$ time units ($\Phi _+$ solid, $\Phi _-$ dashed), against the matched point-mass model (gray). The phantom passes $v_x=0.027$ at $t=30$ and reaches $\approx 0.15$ by $t=60$; the canonical curve turns over near $t\approx 52$ as the halo bias of Sec.~\ref {sec:caveats} takes hold, which is a diagnostic effect and not a deceleration}{figure.5}{}}
