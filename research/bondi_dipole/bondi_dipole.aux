\@writefile{toc}{\contentsline {subsection}{\numberline {E}The phantom sector is the stable one}{5}{section*.16}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces (a)~Barycentre worldlines of the mixed pair \texttt  {pair\_pm}: released at rest at $x=\pm 4$, both bodies move in $+x$ with the phantom (dashed) chasing the canonical star (solid); the shaded band is the closing gap (annotated at three times). (b)~Drifts $\Delta x$, solid $\Phi _+$ and dashed $\Phi _-$: black, reference cell; gray, the equal-$|M_{\rm  ADM}|$ rerun, which changes the phantom's mass by $17\%$ and nothing else---the phantom's trajectory is unchanged (ratio $1.002$ at $t=20$) while the canonical star moves $16\%$ less far (Table~\ref {tab:massscaling}). Light gray: all four null controls, $(+,+)$, $(-,-)$, and both singles, on the same axes. The dotted line marks $t=30$, the end of the halo-clean measurement window (Sec.~\ref {sec:caveats}). (c)~Separation versus its matched point-mass integration: at $d_0=8$ the stars overlap from the start and the NR gap closes to near-contact, where the point-mass model predicts a slowly growing gap.}}{6}{figure.3}\protected@file@percent }
\newlabel{fig:traj}{{3}{6}{(a)~Barycentre worldlines of the mixed pair \texttt {pair\_pm}: released at rest at $x=\pm 4$, both bodies move in $+x$ with the phantom (dashed) chasing the canonical star (solid); the shaded band is the closing gap (annotated at three times). (b)~Drifts $\Delta x$, solid $\Phi _+$ and dashed $\Phi _-$: black, reference cell; gray, the equal-$|M_{\rm ADM}|$ rerun, which changes the phantom's mass by $17\%$ and nothing else---the phantom's trajectory is unchanged (ratio $1.002$ at $t=20$) while the canonical star moves $16\%$ less far (Table~\ref {tab:massscaling}). Light gray: all four null controls, $(+,+)$, $(-,-)$, and both singles, on the same axes. The dotted line marks $t=30$, the end of the halo-clean measurement window (Sec.~\ref {sec:caveats}). (c)~Separation versus its matched point-mass integration: at $d_0=8$ the stars overlap from the start and the NR gap closes to near-contact, where the point-mass model predicts a slowly growing gap}{figure.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Mirror control. Lines: reference cell \texttt  {pair\_pm} (canonical solid, phantom dashed). Open markers: the mirrored cell (sectors swapped; circles canonical, squares phantom), with its drift multiplied by $-1$. Reflecting the configuration reflects the whole trajectory to a few percent---the drift is set by the physics, not the grid.}}{6}{figure.4}\protected@file@percent }
\newlabel{fig:mirror}{{4}{6}{Mirror control. Lines: reference cell \texttt {pair\_pm} (canonical solid, phantom dashed). Open markers: the mirrored cell (sectors swapped; circles canonical, squares phantom), with its drift multiplied by $-1$. Reflecting the configuration reflects the whole trajectory to a few percent---the drift is set by the physics, not the grid}{figure.4}{}}
\@writefile{lot}{\contentsline {table}{\numberline {IV}{\ignorespaces Separation-scaling test: ratio of the measured phantom drift to each cell's \emph  {own} matched point-mass integration. At $d_0=8$ the stars overlap from $t=0$; the growing excess there is the extended-body enhancement.}}{6}{table.4}\protected@file@percent }
\newlabel{tab:sepratios}{{IV}{6}{Separation-scaling test: ratio of the measured phantom drift to each cell's \emph {own} matched point-mass integration. At $d_0=8$ the stars overlap from $t=0$; the growing excess there is the extended-body enhancement}{table.4}{}}
