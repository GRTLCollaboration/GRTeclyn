\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces The runaway, run \texttt  {PM}, in the $z=0$ plane. Top: scalar-field activity $\mathcal  {A}=\DOTSB \sum@ \slimits@ _k(\varphi _k^2+\Pi _k^2)^{1/2}$, both sectors. Bottom: $\chi -1$; the phantom star is a hill ($\chi >1$, blue), the canonical star a well ($\chi <1$, red). Open markers: measured barycentres (circle canonical, square phantom); dashed verticals mark the release positions $x=\pm 4$, arrows the displacements; brackets give the separation, $8.00\rightarrow 1.79$. Panels are individually color-scaled; the canonical well deepens from $\chi _{\min }=0.98$ to $0.44$.}}{6}{figure.3}\protected@file@percent }
\newlabel{fig:frames}{{3}{6}{The runaway, run \texttt {PM}, in the $z=0$ plane. Top: scalar-field activity $\mathcal {A}=\sum _k(\varphi _k^2+\Pi _k^2)^{1/2}$, both sectors. Bottom: $\chi -1$; the phantom star is a hill ($\chi >1$, blue), the canonical star a well ($\chi <1$, red). Open markers: measured barycentres (circle canonical, square phantom); dashed verticals mark the release positions $x=\pm 4$, arrows the displacements; brackets give the separation, $8.00\rightarrow 1.79$. Panels are individually color-scaled; the canonical well deepens from $\chi _{\min }=0.98$ to $0.44$}{figure.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces (a)~Barycentre worldlines of run \texttt  {PM}: released at rest at $x=\pm 4$, both bodies move in $+x$, the phantom (dashed) chasing the canonical star (solid); the shaded band is the closing gap. (b)~Drifts $\Delta x$, solid $\Phi _+$ and dashed $\Phi _-$: black, reference run; gray, \texttt  {PM-eq} (Sec.~\ref {sec:scaling}); light gray, all four null controls. The dotted line marks the clean-window edge $t=30$ (Sec.~\ref {sec:caveats}). (c)~Separation against the matched point-mass integrations: the NR gap closes to near-contact where the model predicts slow growth.}}{6}{figure.4}\protected@file@percent }
\newlabel{fig:traj}{{4}{6}{(a)~Barycentre worldlines of run \texttt {PM}: released at rest at $x=\pm 4$, both bodies move in $+x$, the phantom (dashed) chasing the canonical star (solid); the shaded band is the closing gap. (b)~Drifts $\Delta x$, solid $\Phi _+$ and dashed $\Phi _-$: black, reference run; gray, \texttt {PM-eq} (Sec.~\ref {sec:scaling}); light gray, all four null controls. The dotted line marks the clean-window edge $t=30$ (Sec.~\ref {sec:caveats}). (c)~Separation against the matched point-mass integrations: the NR gap closes to near-contact where the model predicts slow growth}{figure.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Barycentre velocities in run \texttt  {PM}, in code units ($c=1$): centred differences of the continuously sampled barycentre stream over $\pm 2$ time units (canonical solid, phantom dashed; light gray: the matched point-mass model). The dotted line marks the clean-window edge $t=30$; beyond it the halo bias (Sec.~\ref {sec:caveats}) depresses the canonical curve.}}{7}{figure.5}\protected@file@percent }
\newlabel{fig:velocity}{{5}{7}{Barycentre velocities in run \texttt {PM}, in code units ($c=1$): centred differences of the continuously sampled barycentre stream over $\pm 2$ time units (canonical solid, phantom dashed; light gray: the matched point-mass model). The dotted line marks the clean-window edge $t=30$; beyond it the halo bias (Sec.~\ref {sec:caveats}) depresses the canonical curve}{figure.5}{}}
\@writefile{lot}{\contentsline {table}{\numberline {II}{\ignorespaces The measured run against the Newtonian idealization. ``NR'' columns: run \texttt  {PM} as measured. ``model'' columns: a point-mass Bondi integration---two point particles carrying the stars' ADM masses ($+0.0640$ and $-0.0770$), released at rest at the same separation, each accelerated by the \emph  {other's} active mass per Sec.~\ref {sec:model}. Agreement at early times and the growing excess after $t\approx 30$ are discussed in Sec.~\ref {sec:sepscaling}; the clean window is $t\lesssim 30$ (Sec.~\ref {sec:caveats}).}}{7}{table.2}\protected@file@percent }
\newlabel{tab:pointmass}{{II}{7}{The measured run against the Newtonian idealization. ``NR'' columns: run \texttt {PM} as measured. ``model'' columns: a point-mass Bondi integration---two point particles carrying the stars' ADM masses ($+0.0640$ and $-0.0770$), released at rest at the same separation, each accelerated by the \emph {other's} active mass per Sec.~\ref {sec:model}. Agreement at early times and the growing excess after $t\approx 30$ are discussed in Sec.~\ref {sec:sepscaling}; the clean window is $t\lesssim 30$ (Sec.~\ref {sec:caveats})}{table.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Mirror control. Lines: reference run \texttt  {PM} (canonical solid, phantom dashed); open markers: the mirrored run \texttt  {MP}'s drift multiplied by $-1$ (circles canonical, squares phantom). Reflecting the configuration reflects the trajectory to a few percent.}}{7}{figure.6}\protected@file@percent }
\newlabel{fig:mirror}{{6}{7}{Mirror control. Lines: reference run \texttt {PM} (canonical solid, phantom dashed); open markers: the mirrored run \texttt {MP}'s drift multiplied by $-1$ (circles canonical, squares phantom). Reflecting the configuration reflects the trajectory to a few percent}{figure.6}{}}
