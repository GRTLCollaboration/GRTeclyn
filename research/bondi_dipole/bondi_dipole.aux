\@writefile{toc}{\contentsline {title}{\MakeTextUppercase    []{The Bondi Dipole in Full Numerical Relativity: a Self-Accelerating Positive--Negative Mass Binary with \texttt  {GRTeclyn}}}{1}{section*.2}\protected@file@percent }
