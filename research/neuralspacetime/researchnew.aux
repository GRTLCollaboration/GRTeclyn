\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {Supporting fields at peak} ($t\!\approx \!8.4$, $z=0$ slice). Left: required energy density $\rho _{\rm  req}$ [Eq.~\eqref  {eq:rho_req}], with a localized negative-energy (exotic) shell. Center: conformal factor $\chi $, the shallow geometric well. Right: the scalar momentum $\Pi $ of the matter clouds; the massive field oscillates at its Compton period $2\pi /m\!\approx \!5$ while the clouds orbit sub-luminally---this is the dynamical, momentum-carrying source that distinguishes \texttt  {eval\,177} from a static lens.}}{6}{figure.3}\protected@file@percent }
\newlabel{fig:peak_fields}{{3}{6}{\textbf {Supporting fields at peak} ($t\!\approx \!8.4$, $z=0$ slice). Left: required energy density $\rho _{\rm req}$ [Eq.~\eqref {eq:rho_req}], with a localized negative-energy (exotic) shell. Center: conformal factor $\chi $, the shallow geometric well. Right: the scalar momentum $\Pi $ of the matter clouds; the massive field oscillates at its Compton period $2\pi /m\!\approx \!5$ while the clouds orbit sub-luminally---this is the dynamical, momentum-carrying source that distinguishes \texttt {eval\,177} from a static lens}{figure.3}{}}
\@writefile{lot}{\contentsline {table}{\numberline {II}{\ignorespaces \textbf  {Exotic-matter content}, \texttt  {eval\,177} versus an Alcubierre $v_s=2$ bubble, on the common measure of Eq.~\eqref  {eq:eexotic} (geometric units). Energies are proper-volume integrals of the negative Eulerian energy density; ``build'' is the assembled $t=0$ value and ``peak'' the warp-active value. Pointwise NEC minima are probe/resolution dependent; the energy integral is the robust measure.}}{6}{table.2}\protected@file@percent }
\newlabel{tab:exotic}{{II}{6}{\textbf {Exotic-matter content}, \texttt {eval\,177} versus an Alcubierre $v_s=2$ bubble, on the common measure of Eq.~\eqref {eq:eexotic} (geometric units). Energies are proper-volume integrals of the negative Eulerian energy density; ``build'' is the assembled $t=0$ value and ``peak'' the warp-active value. Pointwise NEC minima are probe/resolution dependent; the energy integral is the robust measure}{table.2}{}}
