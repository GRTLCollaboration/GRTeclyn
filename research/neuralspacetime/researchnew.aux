\@writefile{lot}{\contentsline {table}{\numberline {II}{\ignorespaces Longer-run validation ($t=16$, $N_{\rm  full}=64$, $L=8$, H100) with the gated objective (Eq.~\ref {eq:gated_score}). $F_{\rm  op}^{0}$/$F_{\rm  op}^{\rm  ev}$ are the operational FTL benefits on the $t=0$ slice and the evolved plotfile; $\mathrm  {NEC}^{\rm  mat}$ is the minimum matter null-energy margin over the run (negative $=$ violation); $g_{\rm  nt}$ is the non-triviality gate. $S$ is the gated total: flat Minkowski collapses to $0$ while every non-trivial geometry is unchanged. All reference runs use constrained phantom initial data.}}{9}{table.2}\protected@file@percent }
\newlabel{tab:longrun_validation}{{II}{9}{Longer-run validation ($t=16$, $N_{\rm full}=64$, $L=8$, H100) with the gated objective (Eq.~\ref {eq:gated_score}). $F_{\rm op}^{0}$/$F_{\rm op}^{\rm ev}$ are the operational FTL benefits on the $t=0$ slice and the evolved plotfile; $\mathrm {NEC}^{\rm mat}$ is the minimum matter null-energy margin over the run (negative $=$ violation); $g_{\rm nt}$ is the non-triviality gate. $S$ is the gated total: flat Minkowski collapses to $0$ while every non-trivial geometry is unchanged. All reference runs use constrained phantom initial data}{table.2}{}}
\@writefile{lot}{\contentsline {table}{\numberline {III}{\ignorespaces Candidates ranked by the gated objective $S$ (Eq.~\ref {eq:gated_score}). The three top gauge-angular search winners (Tier-1, $t=2$, $N_{\rm  full}=64$) and the high-quality long-run validation of the best ($t=16$, $N_{\rm  full}=192$) are compared to the reference seeds ($t=16$, $N_{\rm  full}=64$). $\DOTSI \intop \ilimits@ \rho _-\,dV$ is the integrated required negative-energy density (geometric requirement from the vacuum Hamiltonian, Eq.~\ref {eq:rho_req}; for the dipole winner it is a single localized core, Fig.~\ref {fig:rho_req}); $\max c$ is the peak coordinate light speed on the initial slice; $F_{\rm  op}^{\rm  ev}$ is the evolved (persistence) operational-FTL benefit. The Tier-1 search $S$ is evaluated over a short window and is therefore optimistic relative to the long-time value---the validated $t=16$ row ($S=16.75$) is the fair comparison with the seeds, and it still outscores Alcubierre. The non-spherical winners use \emph  {normal} matter ($\rho \ge 0$ constrained solve) with low residual exotic content; the reference wormhole/puncture seeds use phantom (exotic) initial data, and Alcubierre's matter sector is clean ($\DOTSI \intop \ilimits@ \rho _-\approx 0$) with its exoticity living in the geometry (effective EC).}}{9}{table.3}\protected@file@percent }
\newlabel{tab:score_comparison}{{III}{9}{Candidates ranked by the gated objective $S$ (Eq.~\ref {eq:gated_score}). The three top gauge-angular search winners (Tier-1, $t=2$, $N_{\rm full}=64$) and the high-quality long-run validation of the best ($t=16$, $N_{\rm full}=192$) are compared to the reference seeds ($t=16$, $N_{\rm full}=64$). $\int \rho _-\,dV$ is the integrated required negative-energy density (geometric requirement from the vacuum Hamiltonian, Eq.~\ref {eq:rho_req}; for the dipole winner it is a single localized core, Fig.~\ref {fig:rho_req}); $\max c$ is the peak coordinate light speed on the initial slice; $F_{\rm op}^{\rm ev}$ is the evolved (persistence) operational-FTL benefit. The Tier-1 search $S$ is evaluated over a short window and is therefore optimistic relative to the long-time value---the validated $t=16$ row ($S=16.75$) is the fair comparison with the seeds, and it still outscores Alcubierre. The non-spherical winners use \emph {normal} matter ($\rho \ge 0$ constrained solve) with low residual exotic content; the reference wormhole/puncture seeds use phantom (exotic) initial data, and Alcubierre's matter sector is clean ($\int \rho _-\approx 0$) with its exoticity living in the geometry (effective EC)}{table.3}{}}
\newlabel{eq:rho_req}{{43}{9}{}{equation.7.43}{}}
\@writefile{toc}{\contentsline {paragraph}{\numberline {b}How can it ``move'' with only an exotic component?}{9}{section*.48}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {The warp dipole is held by a localized exotic core, with negligible ordinary matter.} Left: conformal factor $\chi $ at $z=0$, $t=16$ (bright $=$ expanded, dark $=$ compressed). Right: the geometric required energy density $\rho _{\rm  req}$ of Eq.~\eqref  {eq:rho_req} on the same slice (red $<0$ exotic, blue $>0$ ordinary, shared symmetric scale). The energy-condition violation needed to sustain the geometry is concentrated in one compact core ($\min \rho _{\rm  req}\approx -1.0\times 10^{-3}$) coincident with the compression crescent; the surrounding domain is near-vacuum and the faint outer ring is the weak outgoing $K$-wave (junk radiation), not localized matter.}}{10}{figure.2}\protected@file@percent }
\newlabel{fig:rho_req}{{2}{10}{\textbf {The warp dipole is held by a localized exotic core, with negligible ordinary matter.} Left: conformal factor $\chi $ at $z=0$, $t=16$ (bright $=$ expanded, dark $=$ compressed). Right: the geometric required energy density $\rho _{\rm req}$ of Eq.~\eqref {eq:rho_req} on the same slice (red $<0$ exotic, blue $>0$ ordinary, shared symmetric scale). The energy-condition violation needed to sustain the geometry is concentrated in one compact core ($\min \rho _{\rm req}\approx -1.0\times 10^{-3}$) coincident with the compression crescent; the surrounding domain is near-vacuum and the faint outer ring is the weak outgoing $K$-wave (junk radiation), not localized matter}{figure.2}{}}
