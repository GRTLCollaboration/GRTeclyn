\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces \textbf  {High-resolution shell promotion, zoomed diagnostic slices} ($L=128$, $N_{\rm  full}=256$). Rows show (a) \texttt  {eval\_000106}, the final HQ winner; (b) \texttt  {eval\_000117}, the strongest backup; (c) \texttt  {eval\_000094}, the best channel/shift geometry; and (d) \texttt  {eval\_000011}, the search-scale leader. Columns show local coordinate light speed, shift component $\beta ^x$, scalar momentum $\Pi $, and scalar activity. These frames are taken from the visually diagnostic mid-run slice ($t\simeq 12.5$) rather than the final score slice, where the scalar matter has largely dispersed; the final quantitative verdict is the $t=50.01$ table. The channel-leaning candidates show stronger organized shift and matter-current structure than \texttt  {eval\_000011}.}}{13}{figure.5}\protected@file@percent }
\newlabel{fig:shell_hq_frames}{{5}{13}{\textbf {High-resolution shell promotion, zoomed diagnostic slices} ($L=128$, $N_{\rm full}=256$). Rows show (a) \texttt {eval\_000106}, the final HQ winner; (b) \texttt {eval\_000117}, the strongest backup; (c) \texttt {eval\_000094}, the best channel/shift geometry; and (d) \texttt {eval\_000011}, the search-scale leader. Columns show local coordinate light speed, shift component $\beta ^x$, scalar momentum $\Pi $, and scalar activity. These frames are taken from the visually diagnostic mid-run slice ($t\simeq 12.5$) rather than the final score slice, where the scalar matter has largely dispersed; the final quantitative verdict is the $t=50.01$ table. The channel-leaning candidates show stronger organized shift and matter-current structure than \texttt {eval\_000011}}{figure.5}{}}
