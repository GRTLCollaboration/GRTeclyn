\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Two operational measurements of the same candidate~146 (RM). (a)~Fixed endpoints: dashed = flat ray, solid = curved ray arriving $20\%$ earlier at fixed~$B$. (b)~Free-fall observers: both receivers start at~$B$; the solid worldline drifts in curved spacetime while the dashed one stays inertial. The solid photon hits the curved receiver earlier (``curved'') than the dashed photon hits the inertial one (``flat''). The $7.6\%$ bracket is the proper-time advance. The two protocols differ in what they measure, not in candidate quality.}}{8}{figure.6}\protected@file@percent }
\newlabel{fig:timing_protocols}{{6}{8}{Two operational measurements of the same candidate~146 (RM). (a)~Fixed endpoints: dashed = flat ray, solid = curved ray arriving $20\%$ earlier at fixed~$B$. (b)~Free-fall observers: both receivers start at~$B$; the solid worldline drifts in curved spacetime while the dashed one stays inertial. The solid photon hits the curved receiver earlier (``curved'') than the dashed photon hits the inertial one (``flat''). The $7.6\%$ bracket is the proper-time advance. The two protocols differ in what they measure, not in candidate quality}{figure.6}{}}
