\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {Accepted phantom random candidate.} The geometry is numerically constructible and the pre-flight constraints remain controlled. The required energy density contains negative regions, so it is accepted only in the phantom/exotic-matter class.}}{10}{figure.2}\protected@file@percent }
\newlabel{fig:random000}{{2}{10}{\textbf {Accepted phantom random candidate.} The geometry is numerically constructible and the pre-flight constraints remain controlled. The required energy density contains negative regions, so it is accepted only in the phantom/exotic-matter class}{figure.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {Rejected normal-matter random candidate.} The guessed geometry and derived scalar field are well-defined, but $\rho _{\rm  req}(r)$ becomes negative. Since this candidate is in the normal-matter class, it is rejected as \texttt  {rejected\_exotic\_energy}.}}{10}{figure.3}\protected@file@percent }
\newlabel{fig:random001}{{3}{10}{\textbf {Rejected normal-matter random candidate.} The guessed geometry and derived scalar field are well-defined, but $\rho _{\rm req}(r)$ becomes negative. Since this candidate is in the normal-matter class, it is rejected as \texttt {rejected\_exotic\_energy}}{figure.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces \textbf  {Rejected bad-control candidate.} The conformal factor $\chi (r)$ becomes negative, so the spatial metric $\gamma _{ij}=\chi ^{-1}\delta _{ij}$ is invalid before any matter reconstruction or evolution.}}{10}{figure.4}\protected@file@percent }
\newlabel{fig:badcontrol024}{{4}{10}{\textbf {Rejected bad-control candidate.} The conformal factor $\chi (r)$ becomes negative, so the spatial metric $\gamma _{ij}=\chi ^{-1}\delta _{ij}$ is invalid before any matter reconstruction or evolution}{figure.4}{}}
\@writefile{toc}{\contentsline {subsubsection}{\numberline {8}Representative non-spherical ray figures}{10}{section*.49}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces \textbf  {Accepted non-spherical dipole candidate.} The $l=1$ mode makes the geometry lopsided: one side of the cross-section is compressed/stretched differently from the other. The key result is that $\chi $ stays positive everywhere in the sampled section, so the metric is geometrically valid at this first ray-check level.}}{10}{figure.5}\protected@file@percent }
\newlabel{fig:nonspherical_dipole}{{5}{10}{\textbf {Accepted non-spherical dipole candidate.} The $l=1$ mode makes the geometry lopsided: one side of the cross-section is compressed/stretched differently from the other. The key result is that $\chi $ stays positive everywhere in the sampled section, so the metric is geometrically valid at this first ray-check level}{figure.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces \textbf  {Rejected non-spherical bad control.} The same type of angular deformation is made too strong. The cross-section shows regions where $\chi <0$, which makes $\gamma _{ij}=\chi ^{-1}\delta _{ij}$ invalid. This is rejected before any constraint solve or C++ evolution because the metric itself is not admissible.}}{11}{figure.6}\protected@file@percent }
\newlabel{fig:nonspherical_bad_control}{{6}{11}{\textbf {Rejected non-spherical bad control.} The same type of angular deformation is made too strong. The cross-section shows regions where $\chi <0$, which makes $\gamma _{ij}=\chi ^{-1}\delta _{ij}$ invalid. This is rejected before any constraint solve or C++ evolution because the metric itself is not admissible}{figure.6}{}}
