# Machine / site paths — copy to .env (gitignored) and fill in.
# Nothing in .env should be committed; this file is the public template.
#
#   cp .env.example .env
#   # edit values, then either:
#   source scripts/lib/env.sh
#   # or just run Python — site_paths.load_dotenv() picks it up automatically.
#
# Already-exported shell variables win over .env.
# ${VAR} expansion is supported (see GRTECLYN_ROOT below).

# Parent of GRTeclyn / GRTresna / Chombo
SIM_ROOT=/path/to/simulation

GRTECLYN_ROOT=${SIM_ROOT}/GRTeclyn
GRTRESNA_ROOT=${SIM_ROOT}/GRTresna
CHOMBO_HOME=${SIM_ROOT}/Chombo/lib
OPENMPI_ROOT=${SIM_ROOT}/local/openmpi

# Optional: conda/venv that provides mpirun for GRTresna builds and solves
# GRTRESNA_ENV=/path/to/envs/grtresna
