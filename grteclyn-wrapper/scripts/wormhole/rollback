#!/usr/bin/env bash

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=../lib/env.sh
source "${SCRIPT_DIR}/../lib/env.sh"
SIM_ROOT="$(cd "${GRTECLYN_ROOT}/.." && pwd)"

DEFAULT_DATA_DIR=""
for candidate in "${SIM_ROOT}/data_2gpu" "${SIM_ROOT}/data_supported" "${SIM_ROOT}/data"; do
  if [[ -d "${candidate}" ]]; then
    DEFAULT_DATA_DIR="${candidate}"
    break
  fi
done
if [[ -z "${DEFAULT_DATA_DIR}" ]]; then
  DEFAULT_DATA_DIR="${SIM_ROOT}/data_supported"
fi

DATA_DIR=""
STEP=""
DRY_RUN=false
VIS_DIR="${WRAPPER_ROOT}/src/grteclyn_wrapper/visualisation/visualize"

usage() {
  cat <<'EOF'
Usage:
  rollback --step N [--data DIR] [--vis DIR] [--dry-run]
  rollback N [DIR]

What it does:
  Rolls back a run directory to a checkpoint/plot index N by:
    - deleting plotfile/checkpoint directories with index > N
    - truncating small-data and diagnostics .dat files to the first N (or N+1) rows
    - trimming small_data/consume_state.json to keys <= N
    - deleting rendered frames (including embedding) with index > N
    - deleting generated movies under the visualize folder (so they regenerate)

Examples:
  ./grteclyn-wrapper/scripts/rollback 3000 /path/to/your/simulation/output
  ./grteclyn-wrapper/scripts/rollback --step 3000 --data /path/to/your/simulation/output
  ./grteclyn-wrapper/scripts/rollback --step 3000 --dry-run
EOF
}

is_uint() { [[ "${1:-}" =~ ^[0-9]+$ ]]; }

while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help)
      usage
      exit 0
      ;;
    --dry-run)
      DRY_RUN=true
      shift
      ;;
    --step)
      STEP="${2:-}"
      shift 2
      ;;
    --data)
      DATA_DIR="${2:-}"
      shift 2
      ;;
    --vis)
      VIS_DIR="${2:-}"
      shift 2
      ;;
    *)
      if [[ -z "${STEP}" ]] && is_uint "$1"; then
        STEP="$1"
        shift
      elif [[ -z "${DATA_DIR}" ]]; then
        DATA_DIR="$1"
        shift
      else
        echo "Unknown argument: $1" >&2
        usage >&2
        exit 2
      fi
      ;;
  esac
done

if [[ -z "${STEP}" ]]; then
  echo "Error: missing --step N (or positional N)" >&2
  usage >&2
  exit 2
fi
if [[ -z "${DATA_DIR}" ]]; then
  DATA_DIR="${DEFAULT_DATA_DIR}"
fi

if [[ ! -d "${DATA_DIR}" ]]; then
  echo "Error: data directory does not exist: ${DATA_DIR}" >&2
  exit 2
fi

echo "=========================================="
echo "Rollback target index: ${STEP}"
echo "Run directory:         ${DATA_DIR}"
echo "Visualize directory:   ${VIS_DIR}"
echo "Dry-run:               ${DRY_RUN}"
echo "=========================================="

python - <<PY
from __future__ import annotations

import json
import os
import re
import shutil
from pathlib import Path

DATA_DIR = Path(${DATA_DIR@Q})
VIS_DIR  = Path(${VIS_DIR@Q})
STEP     = int(${STEP@Q})
DRY_RUN  = bool(${DRY_RUN@Q} == "true")

def find_checkpoint_dir(step: int) -> Path:
    patterns = [r"^SupportedWormholeChk(\d+)$", r"^WormholeChk(\d+)$", r"^chk(\d+)$"]
    candidates: list[Path] = []
    for p in DATA_DIR.iterdir():
        if not p.is_dir():
            continue
        for pat in patterns:
            m = re.fullmatch(pat, p.name)
            if not m:
                continue
            try:
                idx = int(m.group(1))
            except ValueError:
                continue
            if idx == step:
                return p
            candidates.append(p)
    for prefix in ("SupportedWormholeChk", "WormholeChk", "chk"):
        for w in (5, 6, 7, 8):
            p = DATA_DIR / f"{prefix}{step:0{w}d}"
            if p.is_dir():
                return p
    raise FileNotFoundError(f"Checkpoint directory for step {step} not found under {DATA_DIR}")

def read_checkpoint_time(chk_dir: Path) -> float:
    header = chk_dir / "Header"
    if not header.is_file():
        raise FileNotFoundError(f"Checkpoint Header not found: {header}")
    lines = header.read_text().splitlines()
    if len(lines) < 3:
        raise ValueError(f"Checkpoint Header too short: {header}")
    try:
        return float(lines[2].strip())
    except ValueError as e:
        raise ValueError(f"Could not parse checkpoint time from line 3 of {header}: {lines[2]!r}") from e

chk_dir = find_checkpoint_dir(STEP)
t_cut = read_checkpoint_time(chk_dir)

print(f"Checkpoint dir:  {chk_dir}")
print(f"Checkpoint time: {t_cut:.16g}")
print("==========================================")

def iter_dirs_matching(patterns: list[re.Pattern[str]]):
    for p in DATA_DIR.iterdir():
        if not p.is_dir():
            continue
        for pat in patterns:
            m = pat.fullmatch(p.name)
            if not m:
                continue
            try:
                idx = int(m.group(2))
            except ValueError:
                continue
            yield p, idx
            break

plot_pats = [re.compile(r"^(SupportedWormholePlt)(\d+)$"),
            re.compile(r"^(WormholePlt)(\d+)$"),
            re.compile(r"^(plt)(\d+)$")]
chk_pats  = [re.compile(r"^(SupportedWormholeChk)(\d+)$"),
            re.compile(r"^(WormholeChk)(\d+)$"),
            re.compile(r"^(chk)(\d+)$")]

removed_plot_dirs = 0
removed_chk_dirs = 0

for p, idx in iter_dirs_matching(plot_pats):
    if idx > STEP:
        if DRY_RUN:
            removed_plot_dirs += 1
        else:
            shutil.rmtree(p)
            removed_plot_dirs += 1

for p, idx in iter_dirs_matching(chk_pats):
    if idx > STEP:
        if DRY_RUN:
            removed_chk_dirs += 1
        else:
            shutil.rmtree(p)
            removed_chk_dirs += 1

def truncate_by_rows(
    path: Path,
    *,
    keep_data_rows: int,
    keep_leading_hash_headers: bool,
) -> tuple[int, int]:
    """Truncate by data row count, not by time (avoids keeping appended rows after a restart in the same dir)."""
    if keep_data_rows < 0:
        raise ValueError("keep_data_rows must be non-negative")
    if not path.exists() or not path.is_file():
        return (0, 0)

    in_lines = path.read_text().splitlines(True)
    out_lines: list[str] = []
    data_rows_kept = 0
    header_phase = True

    for ln in in_lines:
        s = ln.strip()

        if keep_leading_hash_headers and header_phase and s.startswith("#"):
            out_lines.append(ln)
            continue
        header_phase = False

        if not s:
            out_lines.append(ln)
            continue

        if keep_leading_hash_headers and s.startswith("#"):
            out_lines.append(ln)
            continue

        if data_rows_kept < keep_data_rows:
            out_lines.append(ln)
            data_rows_kept += 1
        else:
            break

    if not DRY_RUN:
        path.write_text("".join(out_lines))
    return (len(in_lines), len(out_lines))

trunc_stats: dict[str, tuple[int, int]] = {}
run_data = DATA_DIR / "data"
small_data = DATA_DIR / "small_data"

# data/*.dat: one row per coarse step from step 1 (not indexed like small_data with t=0).
trunc_stats["data/collapse_diagnostics.dat"] = truncate_by_rows(
    run_data / "collapse_diagnostics.dat",
    keep_data_rows=STEP,
    keep_leading_hash_headers=False,
)
trunc_stats["data/constraint_norms.dat"] = truncate_by_rows(
    run_data / "constraint_norms.dat",
    keep_data_rows=STEP,
    keep_leading_hash_headers=False,
)

if small_data.is_dir():
    for p in sorted(small_data.glob("*.dat")):
        # +1 for the t=0 row; data/ diagnostics above use STEP rows only.
        trunc_stats[f"small_data/{p.name}"] = truncate_by_rows(
            p,
            keep_data_rows=STEP + 1,
            keep_leading_hash_headers=True,
        )

state_path = small_data / "consume_state.json"
trimmed_state_keys = 0
max_state_idx = None
if state_path.exists() and state_path.is_file():
    state = json.loads(state_path.read_text())
    kept = {}
    for k, v in state.items():
        m = re.fullmatch(r"(?:SupportedWormholePlt|WormholePlt|plt)(\d+)", k)
        if not m:
            kept[k] = v
            continue
        idx = int(m.group(1))
        if idx <= STEP:
            kept[k] = v
            max_state_idx = idx if max_state_idx is None else max(max_state_idx, idx)
        else:
            trimmed_state_keys += 1
    if not DRY_RUN:
        state_path.write_text(json.dumps(kept, indent=2, sort_keys=True) + "\n")

removed_frames = 0
if VIS_DIR.is_dir():
    pat_axis = re.compile(r"^frame_[A-Za-z]+_(\d+)\.png$")
    pat_emb  = re.compile(r"^frame_(\d+)\.png$")
    for f in VIS_DIR.rglob("frame_*.png"):
        name = f.name
        m = pat_axis.match(name) or pat_emb.match(name)
        if not m:
            continue
        idx = int(m.group(1))
        if idx > STEP:
            removed_frames += 1
            if not DRY_RUN:
                try:
                    f.unlink()
                except FileNotFoundError:
                    pass

removed_movies = 0
if VIS_DIR.is_dir():
    for m in VIS_DIR.rglob("movie_*.mp4"):
        removed_movies += 1
        if not DRY_RUN:
            try:
                m.unlink()
            except FileNotFoundError:
                pass

print(f"Removed plotfile dirs (> {STEP}):     {removed_plot_dirs}")
print(f"Removed checkpoint dirs (> {STEP}):   {removed_chk_dirs}")
print(f"Trimmed consume_state.json keys:      {trimmed_state_keys}")
print(f"Removed rendered frames (> {STEP}):   {removed_frames}")
print(f"Removed movies under visualize/:      {removed_movies}")
print("------------------------------------------")
print("Truncation results (in_lines -> kept_lines):")
for k, (a, b) in trunc_stats.items():
    if a == 0 and b == 0:
        continue
    print(f"  {k}: {a} -> {b}")
PY

echo "=========================================="
echo "Done."
