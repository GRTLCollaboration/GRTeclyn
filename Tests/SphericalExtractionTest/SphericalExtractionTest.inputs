#################################################
# AMReX parameters

amrex.the_arena_init_size = 0 # we run out of memomero otherwise since be default 3/4 of the system’s device memory is allocated

#################################################
# Filesystem parameters

amr.verbose = 1
amrex.verbose = 1

amr.check_int = -1
amr.plot_int = -1

#################################################
# Grid parameters

amr.n_cell = 32 32 32
geometry.prob_extent = 16 16 16

amr.max_level = 1
amr.regrid_int = 1 1
#################################################
# Boundary Conditions parameters
#Periodic directions - 0 = false, 1 = true

geometry.is_periodic = 1 1 1

#################################################
# Evolution parameters

evolution.max_steps = 1

#################################################
# Extraction parameters

extraction.activate_extraction = 1

extraction.num_surfaces = 2
extraction.extraction_radii = 4. 6.
extraction.num_points_phi_lo = 12
extraction.num_points_theta_lo = 13

# Spherical Harmonic to set and extract
extraction.es = 0
extraction.el = 2
extraction.em = 0
