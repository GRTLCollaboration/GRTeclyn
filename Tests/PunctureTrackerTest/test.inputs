#################################################
# Filesystem parameters

amrex.verbose = 1
amr.verbose = 0


amr.check_int = -1
amr.plot_int = -1
amr.plot_vars = shift2

#################################################
# Grid parameters

amr.n_cell = 48 48 24
geometry.prob_extent = 8 8 4

amr.max_level = 2 # There are (max_level+1) levels

amr.regrid_int = 0 0

amr.max_grid_size = 16
amr.blocking_factor = 8

#################################################
# Boundary Conditions parameters

# Periodic directions - 0 = false, 1 = true
geometry.is_periodic = 0 0 0
# if not periodic, then specify the boundary type
# 0 = static, 1 = sommerfeld, 2 = reflective
# (see BoundaryConditions.hpp for details)
boundary.hi_condition = 0 0 0
boundary.lo_condition = 0 0 2

#################################################
# Evolution parameters

# dt will be dx*dt_multiplier on each grid level
evolution.dt_multiplier = 0.25
# evolution.stop_time = 1.0
evolution.max_steps = 2

#################################################
# Puncture Tracking parameters

puncture_tracking.enabled = 1
puncture_tracking.level = 0
puncture_tracking.initial_coords = 2.0 4.0 0.0 6.0 4.0 0.0
puncture_tracking.output_path = PTOutput
