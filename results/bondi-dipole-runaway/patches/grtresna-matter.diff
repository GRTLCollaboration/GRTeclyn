+// ---------------------------------------------------------------------------
+// Tabulated 2D spinning Q-ball (Q-torus) profile f(rho, z) (lump profile == 4).
+//
+// The Python qball_torus solver finds the stationary rotating m=1 eigenstate
+//   Phi = f(rho, z) e^{i(m phi_az - omega t)}
+// by solving the 2D elliptic PDE for the real modulus f(rho, z) and writes it to
+// a table with the header line ``# qball_torus_2d`` followed by metadata comment
+// lines (n_rho, n_z, f_max, ...) and n_rho*n_z data rows ``rho z f`` with z
+// varying fastest (row-major over (i_rho, j_z)).  Loading the exact table here
+// keeps the constraint solve and the gridinit repaint on the SAME f(rho, z).
+// Unlike the 1D radial Q-ball twisted by (sin theta)^m, this f(rho, z) is a
+// genuine eigenstate, so it does not disperse under evolution.
+// ---------------------------------------------------------------------------
+struct qball_torus_table_t
+{
+    std::vector<Real> rho; // 1D axis, uniform, length n_rho
+    std::vector<Real> z;   // 1D axis, uniform, length n_z (z >= 0 half-plane)
+    std::vector<Real> f;   // n_rho*n_z, row-major: f[i*n_z + j]
+    std::size_t n_rho = 0;
+    std::size_t n_z   = 0;
+    Real drho         = 0.0;
+    Real dz           = 0.0;
+    Real f_max        = 0.0;
+};
+
+inline const qball_torus_table_t &qball_torus_load_table(const std::string &path)
+{
+    static std::unordered_map<std::string, qball_torus_table_t> cache;
+    static std::mutex cache_mutex;
+    std::lock_guard<std::mutex> lock(cache_mutex);
+
+    auto found = cache.find(path);
+    if (found != cache.end())
+        return found->second;
+
+    qball_torus_table_t table;
+    if (!path.empty())
+    {
+        std::ifstream file(path);
+        std::string line;
+        std::vector<Real> rr, zz, ff;
+        std::size_t hdr_n_rho = 0, hdr_n_z = 0;
+        Real hdr_fmax = 0.0;
+        while (std::getline(file, line))
+        {
+            std::size_t first = line.find_first_not_of(" \t\r\n");
+            if (first == std::string::npos)
+                continue;
+            if (line[first] == '#')
+            {
+                // Parse key=value tokens out of the comment header.
+                std::istringstream hss(line.substr(first + 1));
+                std::string tok;
+                while (hss >> tok)
+                {
+                    const std::size_t eq = tok.find('=');
+                    if (eq == std::string::npos)
+                        continue;
+                    const std::string key = tok.substr(0, eq);
+                    const std::string val = tok.substr(eq + 1);
+                    if (key == "n_rho")
+                        hdr_n_rho = static_cast<std::size_t>(std::stol(val));
+                    else if (key == "n_z")
+                        hdr_n_z = static_cast<std::size_t>(std::stol(val));
+                    else if (key == "f_max")
+                        hdr_fmax = std::stod(val);
+                }
+                continue;
+            }
+            std::istringstream iss(line);
+            Real a = 0.0, b = 0.0, c = 0.0;
+            if (!(iss >> a >> b >> c))
+                continue;
+            rr.push_back(a);
+            zz.push_back(b);
+            ff.push_back(c);
+        }
+
+        if (hdr_n_rho > 0 && hdr_n_z > 0 &&
+            rr.size() == hdr_n_rho * hdr_n_z)
+        {
+            table.n_rho = hdr_n_rho;
+            table.n_z   = hdr_n_z;
+            table.f     = std::move(ff);
+            // rho axis: every n_z-th row; z axis: first n_z rows (z fastest).
+            table.rho.resize(hdr_n_rho);
+            table.z.resize(hdr_n_z);
+            for (std::size_t i = 0; i < hdr_n_rho; ++i)
+                table.rho[i] = rr[i * hdr_n_z];
+            for (std::size_t j = 0; j < hdr_n_z; ++j)
+                table.z[j] = zz[j];
+            table.drho = (hdr_n_rho > 1) ? (table.rho[1] - table.rho[0]) : 1.0;
+            table.dz   = (hdr_n_z > 1) ? (table.z[1] - table.z[0]) : 1.0;
+            Real fmax  = 0.0;
+            for (Real v : table.f)
+                fmax = std::max(fmax, std::abs(v));
+            table.f_max = (hdr_fmax > 0.0) ? hdr_fmax : fmax;
+        }
+    }
+
+    auto inserted = cache.emplace(path, std::move(table));
+    return inserted.first->second;
+}
+
+// Bilinear interpolation of the 2D torus modulus f at (rho, |z|), normalised by
+// f_max so the peak is 1 (matching qball_envelope's amp scaling).  Returns 0
+// outside the tabulated domain (the eigenstate has already decayed to ~0 there).
+inline Real qball_torus_interp(const qball_torus_table_t &table, Real rho, Real z)
+{
+    if (table.n_rho < 2 || table.n_z < 2 || table.f_max <= 0.0)
+        return 0.0;
+    const Real zz = std::abs(z);
+    if (rho <= table.rho.front() || rho >= table.rho.back() ||
+        zz >= table.z.back())
+        return 0.0;
+
+    const Real fi = (rho - table.rho.front()) / table.drho;
+    const Real fj = (zz - table.z.front()) / table.dz;
+    std::size_t i = static_cast<std::size_t>(fi);
+    std::size_t j = static_cast<std::size_t>(fj);
+    if (i + 1 >= table.n_rho)
+        i = table.n_rho - 2;
+    if (j + 1 >= table.n_z)
+        j = table.n_z - 2;
+    const Real tx = fi - static_cast<Real>(i);
+    const Real ty = fj - static_cast<Real>(j);
+
+    const Real f00 = table.f[i * table.n_z + j];
+    const Real f10 = table.f[(i + 1) * table.n_z + j];
+    const Real f01 = table.f[i * table.n_z + (j + 1)];
+    const Real f11 = table.f[(i + 1) * table.n_z + (j + 1)];
+    const Real val = (1.0 - tx) * ((1.0 - ty) * f00 + ty * f01) +
+                     tx * ((1.0 - ty) * f10 + ty * f11);
+    return val / table.f_max;
+}
